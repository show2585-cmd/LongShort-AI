# Binance 선물 API 경로. 기본값 /binance 는 vite dev 프록시(또는 운영 리버스 프록시)를 거칩니다.
VITE_BINANCE_FAPI_URL=/binance

# true 로 두면 실제 API 대신 합성 데이터로 화면을 띄웁니다 (거래소 접속이 막힌 환경용).
VITE_USE_MOCK=false

# --- SEO (빌드 시 사용) ---
# canonical · og:url · sitemap 에 쓰이는 사이트 주소. 비우면 Vercel 프로덕션 도메인을 자동 사용.
# 커스텀 도메인을 연결하면 반드시 지정하세요.
VITE_SITE_URL=

# 구글 서치콘솔 / 네이버 서치어드바이저 소유확인 메타태그 content 값
VITE_GOOGLE_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
