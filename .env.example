# Binance 선물 API 경로. 기본값 /binance 는 vite dev 프록시(또는 운영 리버스 프록시)를 거칩니다.
VITE_BINANCE_FAPI_URL=/binance

# true 로 두면 실제 API 대신 합성 데이터로 화면을 띄웁니다 (거래소 접속이 막힌 환경용).
VITE_USE_MOCK=false

# --- SEO (빌드 시 사용) ---
# canonical · og:url · sitemap 에 쓰이는 사이트 주소. 비우면 src/shared/config/site.ts 의 SITE.url(https://longshort-ai.com) 사용.
# 미리보기 배포 등 다른 주소로 빌드할 때만 지정하세요.
VITE_SITE_URL=

# 구글 서치콘솔 / 네이버 서치어드바이저 소유확인 메타태그 content 값
VITE_GOOGLE_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=

# --- Google AdSense ---
# 게시자 ID. 비우면 SITE.adsenseClient(ca-pub-7896902472721455) 사용 → 애드센스 스크립트·소유확인 메타·ads.txt 자동 생성
VITE_ADSENSE_CLIENT=
# 승인 후 애드센스에서 만든 디스플레이 광고 단위 ID (비우면 해당 위치 광고 미표시, 자동광고만 사용 가능)
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_CONTENT=
